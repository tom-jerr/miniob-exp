UPDATE BTREE: UPDATE AN INDEXED COLUMN
CREATE TABLE B_UP(ID INT, V INT, PRIMARY KEY(ID)) ENGINE=BTREE;
SUCCESS
INSERT INTO B_UP VALUES(1,10);
SUCCESS
INSERT INTO B_UP VALUES(2,20);
SUCCESS
INSERT INTO B_UP VALUES(3,30);
SUCCESS
CREATE INDEX I_V ON B_UP(V);
SUCCESS
UPDATE B_UP SET V=99 WHERE ID=2;
SUCCESS
SELECT * FROM B_UP;
1 | 10
2 | 99
3 | 30
ID | V
SELECT * FROM B_UP WHERE V=99;
2 | 99
ID | V
SELECT * FROM B_UP WHERE V=20;
ID | V

UPDATE BTREE: CHANGE THE PRIMARY KEY
UPDATE B_UP SET ID=10 WHERE ID=3;
SUCCESS
SELECT * FROM B_UP;
1 | 10
10 | 30
2 | 99
ID | V
SELECT * FROM B_UP WHERE ID=10;
10 | 30
ID | V
SELECT * FROM B_UP WHERE ID=3;
ID | V

UPDATE BTREE: DUPLICATE PRIMARY KEY MUST FAIL AND KEEP THE OLD ROW
UPDATE B_UP SET ID=1 WHERE ID=2;
FAILURE
SELECT * FROM B_UP;
1 | 10
10 | 30
2 | 99
ID | V
SELECT * FROM B_UP WHERE ID=2;
2 | 99
ID | V

UPDATE BTREE: UPDATE WITHOUT WHERE
UPDATE B_UP SET V=0;
SUCCESS
SELECT * FROM B_UP WHERE V=0;
1 | 0
10 | 0
2 | 0
ID | V

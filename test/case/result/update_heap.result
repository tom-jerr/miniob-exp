UPDATE HEAP: UPDATE AN INDEXED COLUMN
CREATE TABLE T_UP(ID INT, V INT);
SUCCESS
INSERT INTO T_UP VALUES(1,10);
SUCCESS
INSERT INTO T_UP VALUES(2,20);
SUCCESS
INSERT INTO T_UP VALUES(3,30);
SUCCESS
CREATE INDEX I_V ON T_UP(V);
SUCCESS
UPDATE T_UP SET V=99 WHERE ID=2;
SUCCESS
SELECT * FROM T_UP;
1 | 10
2 | 99
3 | 30
ID | V
SELECT * FROM T_UP WHERE V=99;
2 | 99
ID | V
SELECT * FROM T_UP WHERE V=20;
ID | V

UPDATE HEAP: UPDATE THE ID COLUMN
UPDATE T_UP SET ID=10 WHERE ID=3;
SUCCESS
SELECT * FROM T_UP;
1 | 10
10 | 30
2 | 99
ID | V

UPDATE HEAP: UPDATE WITHOUT WHERE
UPDATE T_UP SET V=0;
SUCCESS
SELECT * FROM T_UP;
1 | 0
10 | 0
2 | 0
ID | V
SELECT * FROM T_UP WHERE V=0;
1 | 0
10 | 0
2 | 0
ID | V

UPDATE HEAP: INVALID STATEMENTS
UPDATE T_UP_MISSING SET V=1;
FAILURE
UPDATE T_UP SET MISSING_COLUMN=1;
FAILURE
UPDATE T_UP SET V='NOT_AN_INT' WHERE ID=1;
FAILURE
SELECT * FROM T_UP;
1 | 0
10 | 0
2 | 0
ID | V

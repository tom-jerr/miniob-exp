UPDATE INDEX: UPDATE AN INDEXED COLUMN
CREATE TABLE T_IX(ID INT, V INT);
SUCCESS
INSERT INTO T_IX VALUES(1,10);
SUCCESS
INSERT INTO T_IX VALUES(2,20);
SUCCESS
INSERT INTO T_IX VALUES(3,30);
SUCCESS
CREATE INDEX I_V ON T_IX(V);
SUCCESS
UPDATE T_IX SET V=99 WHERE ID=2;
SUCCESS
SELECT * FROM T_IX;
1 | 10
2 | 99
3 | 30
ID | V
SELECT * FROM T_IX WHERE V=99;
2 | 99
ID | V
SELECT * FROM T_IX WHERE V=20;
ID | V

UPDATE INDEX: DUPLICATE INDEX KEYS
UPDATE T_IX SET V=99 WHERE ID=3;
SUCCESS
SELECT * FROM T_IX WHERE V=99;
2 | 99
3 | 99
ID | V

UPDATE INDEX: UPDATE THE INDEXED COLUMN AGAIN
UPDATE T_IX SET V=77 WHERE ID=2;
SUCCESS
SELECT * FROM T_IX;
1 | 10
2 | 77
3 | 99
ID | V
SELECT * FROM T_IX WHERE V=99;
3 | 99
ID | V
SELECT * FROM T_IX WHERE V=77;
2 | 77
ID | V

UPDATE INDEX: UPDATE THE ID COLUMN
UPDATE T_IX SET ID=10 WHERE ID=1;
SUCCESS
SELECT * FROM T_IX;
10 | 10
2 | 77
3 | 99
ID | V
SELECT * FROM T_IX WHERE ID=10;
10 | 10
ID | V

UPDATE INDEX: FAILED UPDATE KEEPS DATA
UPDATE T_IX SET V='NOT_AN_INT' WHERE ID=10;
FAILURE
SELECT * FROM T_IX;
10 | 10
2 | 77
3 | 99
ID | V

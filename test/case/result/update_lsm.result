UPDATE LSM: UPDATE AN INDEXED COLUMN
CREATE TABLE L_UP(ID INT, V INT) ENGINE=LSM;
SUCCESS
INSERT INTO L_UP VALUES(1,10);
SUCCESS
INSERT INTO L_UP VALUES(2,20);
SUCCESS
INSERT INTO L_UP VALUES(3,30);
SUCCESS
CREATE INDEX I_V ON L_UP(V);
SUCCESS
UPDATE L_UP SET V=99 WHERE ID=2;
SUCCESS
SELECT * FROM L_UP;
1 | 10
2 | 99
3 | 30
ID | V
SELECT * FROM L_UP WHERE V=99;
2 | 99
ID | V
SELECT * FROM L_UP WHERE V=20;
ID | V

UPDATE LSM: UPDATE THE ID COLUMN
UPDATE L_UP SET ID=5 WHERE ID=3;
SUCCESS
SELECT * FROM L_UP;
1 | 10
2 | 99
5 | 30
ID | V

UPDATE LSM: UPDATE WITHOUT WHERE
UPDATE L_UP SET V=0;
SUCCESS
SELECT * FROM L_UP WHERE V=0;
1 | 0
2 | 0
5 | 0
ID | V

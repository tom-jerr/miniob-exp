BTREE ENGINE: CLUSTERED PRIMARY KEY
CREATE TABLE B_PK(ID INT, AGE INT, NAME CHAR(10), PRIMARY KEY(ID)) ENGINE=BTREE;
SUCCESS
INSERT INTO B_PK VALUES(2,20,'B');
SUCCESS
INSERT INTO B_PK VALUES(1,10,'A');
SUCCESS
INSERT INTO B_PK VALUES(3,20,'C');
SUCCESS
SELECT ID, AGE FROM B_PK;
ID | AGE
1 | 10
2 | 20
3 | 20
BTREE ENGINE: DUPLICATE PRIMARY KEY MUST FAIL
INSERT INTO B_PK VALUES(1,99,'DUP');
FAILURE
BTREE ENGINE: SECONDARY INDEX
CREATE INDEX B_AGE ON B_PK(AGE);
SUCCESS
SELECT ID FROM B_PK WHERE AGE=20;
2
3
ID
DELETE FROM B_PK WHERE ID=2;
SUCCESS
SELECT ID FROM B_PK WHERE AGE=20;
3
ID
SELECT ID FROM B_PK;
ID
1
3

BTREE ENGINE: HIDDEN ROWID
CREATE TABLE B_ROWID(A INT, V INT) ENGINE=BTREE;
SUCCESS
INSERT INTO B_ROWID VALUES(20,1);
SUCCESS
INSERT INTO B_ROWID VALUES(10,2);
SUCCESS
SELECT * FROM B_ROWID;
A | V
20 | 1
10 | 2

BTREE ENGINE: COMPOSITE PRIMARY KEY
CREATE TABLE B_COMP(A INT, B INT, V INT, PRIMARY KEY(A,B)) ENGINE=BTREE;
SUCCESS
INSERT INTO B_COMP VALUES(2,1,21);
SUCCESS
INSERT INTO B_COMP VALUES(1,2,12);
SUCCESS
INSERT INTO B_COMP VALUES(1,1,11);
SUCCESS
SELECT * FROM B_COMP;
A | B | V
1 | 1 | 11
1 | 2 | 12
2 | 1 | 21

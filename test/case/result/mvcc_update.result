MVCC UPDATE: UNCOMMITTED WRITES ARE VISIBLE ONLY TO THEIR TRANSACTION
CREATE TABLE M_UP(ID INT, V INT);
SUCCESS
INSERT INTO M_UP VALUES(1,10);
SUCCESS
INSERT INTO M_UP VALUES(2,20);
SUCCESS
INSERT INTO M_UP VALUES(3,30);
SUCCESS
CREATE INDEX I_V ON M_UP(V);
SUCCESS
SELECT * FROM M_UP WHERE V=10;
1 | 10
ID | V
BEGIN;
SUCCESS
UPDATE M_UP SET V=99 WHERE ID=2;
SUCCESS
SELECT * FROM M_UP;
1 | 10
2 | 99
3 | 30
ID | V
SELECT * FROM M_UP WHERE V=99;
2 | 99
ID | V
SELECT * FROM M_UP WHERE V=20;
ID | V
SELECT * FROM M_UP;
1 | 10
2 | 20
3 | 30
ID | V
SELECT * FROM M_UP WHERE V=99;
ID | V
ROLLBACK;
SUCCESS
SELECT * FROM M_UP;
1 | 10
2 | 20
3 | 30
ID | V
SELECT * FROM M_UP WHERE V=99;
ID | V

MVCC UPDATE: COMMIT PUBLISHES THE NEW VERSION
BEGIN;
SUCCESS
UPDATE M_UP SET V=77 WHERE ID=1;
SUCCESS
COMMIT;
SUCCESS
SELECT * FROM M_UP;
1 | 77
2 | 20
3 | 30
ID | V
SELECT * FROM M_UP WHERE V=77;
1 | 77
ID | V
SELECT * FROM M_UP WHERE V=10;
ID | V

MVCC UPDATE: FAILED STATEMENT ABORTS THE TRANSACTION
BEGIN;
SUCCESS
UPDATE M_UP SET MISSING_COLUMN=1;
FAILURE
COMMIT;
FAILURE
SELECT * FROM M_UP;
1 | 77
2 | 20
3 | 30
ID | V

MVCC UPDATE: CONCURRENT WRITE CONFLICT FAILS THE STATEMENT
BEGIN;
SUCCESS
UPDATE M_UP SET V=55 WHERE ID=3;
SUCCESS
UPDATE M_UP SET V=11 WHERE ID=1;
SUCCESS
UPDATE M_UP SET V=66 WHERE ID=3;
FAILURE
ROLLBACK;
SUCCESS
SELECT * FROM M_UP WHERE ID=1;
1 | 11
ID | V
SELECT * FROM M_UP WHERE ID=3;
3 | 30
ID | V

MVCC UPDATE: SYNC RECLAIMS OLD VERSIONS WITHOUT CHANGING VISIBILITY
SYNC;
SUCCESS
SELECT * FROM M_UP WHERE V=10;
ID | V
SELECT * FROM M_UP WHERE V=11;
1 | 11
ID | V

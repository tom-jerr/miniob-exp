LSM ENGINE: INSERT AND SCAN
CREATE TABLE L_T(ID INT, V INT) ENGINE=LSM;
SUCCESS
INSERT INTO L_T VALUES(1,10);
SUCCESS
INSERT INTO L_T VALUES(2,20);
SUCCESS
INSERT INTO L_T VALUES(3,30);
SUCCESS
SELECT * FROM L_T;
ID | V
1 | 10
2 | 20
3 | 30
LSM ENGINE: SECONDARY INDEX
CREATE INDEX L_V ON L_T(V);
SUCCESS
SELECT * FROM L_T WHERE V=20;
2 | 20
ID | V
LSM ENGINE: DELETE AND INDEX MAINTENANCE
DELETE FROM L_T WHERE V=30;
SUCCESS
SELECT * FROM L_T;
ID | V
1 | 10
2 | 20
SELECT * FROM L_T WHERE V=20;
2 | 20
ID | V
SELECT * FROM L_T WHERE V=30;
ID | V
